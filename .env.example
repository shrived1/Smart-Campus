# Server / Auth Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-strong-random-32-byte-secret-in-production
CORS_ORIGIN=

# Optional Frontend API Base URL (leave empty when deploying frontend + /api on the same Vercel project or Express host)
VITE_API_BASE_URL=

# Optional Server-side Gemini API Key
GEMINI_API_KEY=
