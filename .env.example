# Server / Auth Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-strong-random-32-byte-secret-in-production
# Demo 1-click portal auth is enabled in development by default and disabled in production unless explicitly set to true:
ENABLE_DEMO_AUTH=false
ENABLE_DEMO_ADMIN_AUTH=false
CORS_ORIGIN=

# Frontend Build Configuration
# Leave VITE_API_BASE_URL empty when deploying frontend + /api together on Vercel or a single Node host.
# Set VITE_API_BASE_URL=https://smartcollage.vercel.app when hosting static files separately (e.g. GitHub Pages).
VITE_API_BASE_URL=
VITE_BASE_PATH=/

# Optional Server-side Gemini API Key
GEMINI_API_KEY=
